# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to git.

# --- Brain backend ---
# "anthropic" (default): uses the paid Claude API. Best reasoning/tool-use
#   quality; requires ANTHROPIC_API_KEY and billing set up at
#   console.anthropic.com (separate from a Claude Pro subscription — Pro
#   does NOT include API credit).
# "ollama": uses a free, fully local open-source model via Ollama
#   (https://ollama.com). No API cost, no data ever leaves your machine —
#   but weaker reasoning and less reliable tool calls than Claude. See
#   README.md for setup steps.
JARVIS_BACKEND=anthropic

# Required only if JARVIS_BACKEND=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
JARVIS_MODEL=claude-sonnet-4-5

# Required only if JARVIS_BACKEND=ollama
# Model must be pulled first: `ollama pull llama3.1:8b`
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# --- Guardrails ---
# If true (default), any transcript that looks like it contains PII is
# masked and the user must explicitly confirm before it is sent to Claude
# or written to any log file.
JARVIS_PII_GUARD=true

# If true (default), Claude is only allowed to *propose* tool/action calls.
# Every proposed action is read back to the user and requires explicit
# confirmation (typed "yes" or spoken "confirm") before it executes.
JARVIS_CONFIRM_ACTIONS=true

# If true, conversation transcripts (already PII-redacted) are appended to
# ./logs/conversation.log for debugging. Default: false (nothing persisted).
JARVIS_ENABLE_LOGGING=false

# --- STT backend ---
# "local" (default) runs faster-whisper on-device; audio never leaves the
# machine. "openai" would send audio to a cloud API (not implemented by
# default — left as a placeholder to make the privacy trade-off explicit).
JARVIS_STT_BACKEND=local
JARVIS_WHISPER_MODEL=base.en

# --- TTS backend ---
# "local" (default, pyttsx3, fully offline) or "elevenlabs" (cloud, needs
# ELEVENLABS_API_KEY and sends response text to a third party).
JARVIS_TTS_BACKEND=local
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
